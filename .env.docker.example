# 项目管理系统 docker-compose 部署配置
# 复制为 .env 后修改各项值

# 镜像 tag（默认 latest，也可固定版本如 v1.0.0）
TAG=latest

# 监听地址与端口：默认只绑本机回环，由宿主机 Nginx/Caddy 反代对外
BIND_IP=127.0.0.1
SERVER_PORT=3000

# 登录密码（必填）
APP_PASSWORD=change-me

# session 签名密钥（必填，随机长字符串）
AUTH_SECRET=change-me-to-a-random-long-secret

# GitHub 仓库（用于页面内检查更新/自更新）
GITHUB_REPO=fluxcode666/project-manager

# 私有仓库需要 token；公开仓库留空
GITHUB_TOKEN=

# 启动时自动执行数据库迁移
AUTO_MIGRATE=true
